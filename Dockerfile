# 1. 베이스 이미지를 지정합니다. (Node.js 20 버전이 깔려있는 가벼운 리눅스를 가져옵니다)
FROM node:20-alpine

# 2. 이미지 내부에서 명령어를 실행할 작업 디렉토리를 생성하고 이동합니다.
WORKDIR /usr/src/app

# 3. 라이브러리 목록 파일들을 먼저 복사합니다.
COPY package*.json ./

# 4. 이미지 내부에서 라이브러리를 설치합니다.
RUN npm install

# 5. 나머지 소스 코드 전체를 이미지 내부로 복사합니다.
COPY . .

# 6. 이 컨테이너가 외부로 개방할 포트를 지정합니다.
EXPOSE 3000

# 7. 컨테이너가 켜지는 순간 실행할 명령어를 지정합니다.
CMD ["npm", "start"]